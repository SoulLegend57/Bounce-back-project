    private void addUpgrade(String id, String name, String description, String category, String rarity, String type, int amount) {
        upgradeCatalog.add(new Upgrade(id, name, description, category, rarity, type, amount));
    }

    private Upgrade findUpgrade(String id) {
        for (Upgrade u : upgradeCatalog) if (u.id.equals(id)) return u;
        return null;
    }
    private boolean has(String id) {
        for (Upgrade u : ownedUpgrades) if (u.id.equals(id)) return true;
        return false;
    }
    private int bonus(String type) {
        int total = 0;
        for (Upgrade u : ownedUpgrades) if (u.type.equals(type)) total += u.amount;
        return total;
    }

    // ---------- Save and load ----------
    private void saveProgress() {
        Properties data = new Properties();
        data.setProperty("coins", String.valueOf(coins));
        data.setProperty("games", String.valueOf(gamesPlayed));
        data.setProperty("wins", String.valueOf(wins));
        data.setProperty("losses", String.valueOf(losses));
        data.setProperty("pushes", String.valueOf(pushes));
        data.setProperty("naturals", String.valueOf(naturalBlackjacks));
        data.setProperty("streak", String.valueOf(currentStreak));
        data.setProperty("bestStreak", String.valueOf(bestStreak));
        data.setProperty("earned", String.valueOf(totalCoinsEarned));
        data.setProperty("spent", String.valueOf(totalCoinsSpent));
        data.setProperty("bought", String.valueOf(upgradesBought));
        data.setProperty("doubleWins", String.valueOf(doubleDownWins));
        data.setProperty("shops", String.valueOf(shopVisits));
        data.setProperty("history", String.join("\n", history));
        StringBuilder ids = new StringBuilder();
        for (Upgrade u : ownedUpgrades) { if (ids.length() > 0) ids.append(","); ids.append(u.id); }
        data.setProperty("owned", ids.toString());
        StringBuilder ach = new StringBuilder();
        for (String id : achievements) { if (ach.length() > 0) ach.append(","); ach.append(id); }
        data.setProperty("achievements", ach.toString());
        try (FileOutputStream out = new FileOutputStream(SAVE_FILE)) {
            data.store(out, "Blackjack Builder Deluxe Save Data");
        } catch (IOException ex) {
            // Some school coding environments do not permit local file saving.
        }
    }

    private void loadProgress() {
        Properties data = new Properties();
        try (FileInputStream in = new FileInputStream(SAVE_FILE)) {
            data.load(in);
            coins = getInt(data, "coins", coins);
            gamesPlayed = getInt(data, "games", 0);
            wins = getInt(data, "wins", 0);
            losses = getInt(data, "losses", 0);
            pushes = getInt(data, "pushes", 0);
            naturalBlackjacks = getInt(data, "naturals", 0);
            currentStreak = getInt(data, "streak", 0);
            bestStreak = getInt(data, "bestStreak", 0);
            totalCoinsEarned = getInt(data, "earned", 0);
            totalCoinsSpent = getInt(data, "spent", 0);
            upgradesBought = getInt(data, "bought", 0);
            doubleDownWins = getInt(data, "doubleWins", 0);
            shopVisits = getInt(data, "shops", 0);
            String owned = data.getProperty("owned", "");
            if (!owned.isEmpty()) for (String id : owned.split(",")) {
                Upgrade u = findUpgrade(id); if (u != null && !has(id)) ownedUpgrades.add(u);
            }
            String ach = data.getProperty("achievements", "");
            if (!ach.isEmpty()) achievements.addAll(Arrays.asList(ach.split(",")));
            String oldHistory = data.getProperty("history", "");
            if (!oldHistory.isEmpty()) history.addAll(Arrays.asList(oldHistory.split("\n")));
        } catch (IOException ex) {
            // First launch: start with the default balance and empty collection.
        }
    }

    private int getInt(Properties p, String key, int fallback) {
        try { return Integer.parseInt(p.getProperty(key, String.valueOf(fallback))); }
        catch (NumberFormatException ex) { return fallback; }
    }

