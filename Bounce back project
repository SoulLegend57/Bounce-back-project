    // ---------- Round flow ----------
    private void startRound() {
        if (roundActive || shopOpen) return;
        playerHand = new ArrayList<Card>();
        dealerHand = new ArrayList<Card>();
        deck = new Deck();
        roundActive = true;
        roundFinished = false;
        dealerRevealed = false;
        doubledDown = false;
        peekUsed = false;
        shieldUsed = false;
        firstHit = false;
        playerStood = false;
        totalHits = totalHits;
        playerHand.add(deck.draw());
        dealerHand.add(deck.draw());
        playerHand.add(deck.draw());
        dealerHand.add(deck.draw());
        lastReward = 0;
        hitButton.setVisible(true);
        standButton.setVisible(true);
        doubleButton.setVisible(canDoubleDown());
        peekButton.setVisible(has("peek"));
        peekButton.setEnabled(true);
        startButton.setVisible(false);
        replayButton.setVisible(false);
        upgradesButton.setEnabled(false);
        historyButton.setEnabled(false);
        statsButton.setEnabled(false);
        helpButton.setEnabled(false);
        saveButton.setEnabled(false);
        statusLabel.setText("Your turn. Hit, Stand, or Double Down.");
        renderHands(false);
        refreshDashboard();
        if (isNatural(playerHand)) {
            statusLabel.setText("Natural Blackjack! The dealer will reveal their hand.");
            stand();
        }
    }

    private void hit() {
        if (!roundActive) return;
        playerHand.add(deck.draw());
        firstHit = true;
        totalHits++;
        int value = playerTotal();
        if (value > 21 && !shieldUsed && canUseBustShield(value)) {
            shieldUsed = true;
            statusLabel.setText("A protective upgrade activated! Your bust was prevented.");
            value = playerTotal();
        }
        renderHands(false);
        if (value > 21) {
            settleRound("BUST! The dealer wins.", false, false);
        } else if (value == 21) {
            statusLabel.setText("21! You automatically stand.");
            stand();
        } else {
            statusLabel.setText("You drew " + playerHand.get(playerHand.size() - 1) + ". Your total is " + value + ".");
            doubleButton.setVisible(false);
        }
    }

    private boolean canUseBustShield(int value) {
        return (value == 22 && has("shield22")) || ((value == 23 || value == 24) && has("shield24")) || (value == 25 && has("shield25"));
    }

    private void stand() {
        if (!roundActive) return;
        playerStood = true;
        dealerRevealed = true;
        while (dealerTotal() < dealerTarget()) dealerHand.add(deck.draw());
        renderHands(true);
        int p = playerTotal();
        int d = dealerTotal();
        boolean pn = isNatural(playerHand);
        boolean dn = isNatural(dealerHand);
        if (dn && !pn) settleRound("The dealer has a natural Blackjack. Dealer wins.", false, false);
        else if (pn && !dn) settleRound("NATURAL BLACKJACK! YOU WIN!", true, true);
        else if (d > 21) settleRound("The dealer busted! YOU WIN!", true, false);
        else if (p > d) settleRound("YOU WIN! Your hand beat the dealer.", true, false);
        else if (p < d) settleRound("The dealer wins this round.", false, false);
        else settleRound("PUSH! It's a tie. No coins gained or lost.", false, false, true);
    }

    private boolean canDoubleDown() {
        return roundActive && playerHand.size() == 2 && !firstHit && !doubledDown;
    }

    private void doubleDown() {
        if (!canDoubleDown()) return;
        doubledDown = true;
        playerHand.add(deck.draw());
        totalHits++;
        renderHands(false);
        if (playerTotal() > 21) settleRound("DOUBLE DOWN BUST! The dealer wins.", false, false);
        else stand();
    }

    private void peek() {
        if (!roundActive || !has("peek") || peekUsed) return;
        peekUsed = true;
        dealerRevealed = true;
        renderHands(false);
        peekButton.setEnabled(false);
        statusLabel.setText("Your Peek upgrade reveals the dealer's hidden card. Choose carefully!");
    }

    private void settleRound(String message, boolean won, boolean natural) {
        settleRound(message, won, natural, false);
    }

    private void settleRound(String message, boolean won, boolean natural, boolean push) {
        if (!roundActive) return;
        roundActive = false;
        roundFinished = true;
        dealerRevealed = true;
        gamesPlayed++;
        int p = playerTotal();
        int d = dealerTotal();
        int reward = 0;

        if (push) {
            pushes++;
            currentStreak = 0;
        } else if (won) {
            wins++;
            currentStreak++;
            bestStreak = Math.max(bestStreak, currentStreak);
            reward = 4 + random.nextInt(4) + bonus("wincoins");
            if (natural) { naturalBlackjacks++; reward += bonus("naturalcoins"); }
            if (d > 21) reward += bonus("dealerbustcoins");
            if (p >= 20) reward += bonus("highhandcoins");
            if (d <= 21 && p - d >= 5) reward += bonus("margincoins");
            if (containsRank(playerHand, "7")) reward += bonus("sevencoins");
            if (containsRoyalSet(playerHand)) reward += bonus("royalcoins");
            if (doubledDown) { reward += bonus("doublecoins"); doubleDownWins++; }
            reward += bonus("streakcoins") * Math.max(0, currentStreak - 1);
            coins += reward;
            totalCoinsEarned += reward;
        } else {
            losses++;
            currentStreak = 0;
        }
        lastReward = reward;
        if (reward > 0) message += "  +" + reward + " coins!";
        if (natural && won) message += "  (NATURAL BLACKJACK)";
        lastResult = message;
        String result = push ? "PUSH" : (won ? "WIN" : "LOSS");
        history.add(0, "Game " + gamesPlayed + "  |  " + result + "  |  You " + p + " — Dealer " + d + "  |  +" + reward + " coins");
        if (history.size() > 30) history.remove(history.size() - 1);

        renderHands(true);
        statusLabel.setText(message);
        hitButton.setVisible(false);
        standButton.setVisible(false);
        doubleButton.setVisible(false);
        peekButton.setVisible(false);
        replayButton.setVisible(gamesPlayed % 5 != 0);
        startButton.setVisible(gamesPlayed % 5 != 0);
        upgradesButton.setEnabled(true);
        historyButton.setEnabled(true);
        statsButton.setEnabled(true);
        helpButton.setEnabled(true);
        saveButton.setEnabled(true);
        refreshDashboard();
        checkAchievements();
        saveProgress();
        if (gamesPlayed % 5 == 0) SwingUtilities.invokeLater(this::openShop);
    }

    // ---------- Hand values ----------
    private int playerTotal() { return handValue(playerHand, true); }
    private int dealerTotal() { return handValue(dealerHand, false); }

    private int handValue(List<Card> hand, boolean player) {
        int total = 0;
        int aces = 0;
        for (int i = 0; i < hand.size(); i++) {
            Card c = hand.get(i);
            int value = c.value();
            if (c.rank.equals("A")) aces++;
            if (player) value += cardBonus(c, i);
            total += value;
        }
        while (total > 21 && aces > 0) { total -= 10; aces--; }
        if (player) {
            total += bonus("handpoints");
            if (playerStood) total += bonus("standpoints");
            if (shieldUsed && total > 21) total = 21;
        }
        return total;
    }

    private int cardBonus(Card c, int index) {
        int value = bonus("allcards");
        if (index == 0) value += bonus("firstcard");
        if (index < 2) value += bonus("openingcards");
        if (c.rank.equals("A")) value += bonus("aces");
        if (c.rank.equals("J") || c.rank.equals("Q") || c.rank.equals("K")) value += bonus("faces");
        if (c.rank.matches("[2-9]") || c.rank.equals("10")) value += bonus("numbercards");
        if (c.suit.equals("♥")) value += bonus("hearts");
        if (c.suit.equals("♦")) value += bonus("diamonds");
        if (c.suit.equals("♠")) value += bonus("spades");
        if (c.suit.equals("♣")) value += bonus("clubs");
        return value;
    }

    private int dealerTarget() { return Math.max(15, Math.min(19, 17 + bonus("dealerstand"))); }
    private boolean isNatural(List<Card> hand) { return hand.size() == 2 && hand.get(0).value() + hand.get(1).value() == 21; }
    private boolean containsRank(List<Card> hand, String rank) {
        for (Card c : hand) if (c.rank.equals(rank)) return true;
        return false;
    }
    private boolean containsRoyalSet(List<Card> hand) {
        return containsRank(hand, "J") && containsRank(hand, "Q") && containsRank(hand, "K");
    }

    // ---------- Card rendering ----------
    private void renderHands(boolean reveal) {
        dealerCardsPanel.removeAll();
        playerCardsPanel.removeAll();
        for (int i = 0; i < dealerHand.size(); i++) {
            boolean hidden = i == 1 && !reveal && !dealerRevealed;
            dealerCardsPanel.add(cardView(hidden ? null : dealerHand.get(i), hidden));
        }
        for (Card c : playerHand) playerCardsPanel.add(cardView(c, false));
        if (dealerHand.isEmpty()) dealerTotal.setText("TOTAL  —");
        else if (reveal || dealerRevealed) dealerTotal.setText("TOTAL  " + dealerTotal());
        else dealerTotal.setText("SHOWING  " + dealerHand.get(0).value() + "  +  ?");
        playerTotal.setText("TOTAL  " + (playerHand.isEmpty() ? "0" : playerTotal()));
        dealerCardsPanel.revalidate(); dealerCardsPanel.repaint();
        playerCardsPanel.revalidate(); playerCardsPanel.repaint();
    }

    private JPanel cardView(Card card, boolean hidden) {
        JPanel panel = new JPanel(new BorderLayout(2, 2));
        panel.setPreferredSize(new Dimension(82, 112));
        panel.setBackground(hidden ? new Color(27, 57, 91) : CREAM);
        panel.setBorder(new CompoundBorder(new LineBorder(hidden ? GOLD : new Color(205, 197, 174), 2, true),
                new EmptyBorder(6, 7, 6, 7)));
        if (hidden) {
            JLabel mark = new JLabel("✦", SwingConstants.CENTER);
            mark.setForeground(GOLD); mark.setFont(new Font("Serif", Font.BOLD, 38));
            JLabel back = new JLabel("BUILDER", SwingConstants.CENTER);
            back.setForeground(Color.WHITE); back.setFont(new Font("Arial", Font.BOLD, 8));
            panel.add(mark, BorderLayout.CENTER); panel.add(back, BorderLayout.SOUTH);
        } else if (card != null) {
            Color ink = (card.suit.equals("♥") || card.suit.equals("♦")) ? RED : new Color(27, 31, 35);
            JLabel corner = new JLabel(card.rank + card.suit);
            corner.setForeground(ink); corner.setFont(new Font("Arial", Font.BOLD, 17));
            JLabel suit = new JLabel(card.suit, SwingConstants.CENTER);
            suit.setForeground(ink); suit.setFont(new Font("Serif", Font.PLAIN, 37));
            panel.add(corner, BorderLayout.NORTH); panel.add(suit, BorderLayout.CENTER);
        }
        return panel;
    }

    // ---------- Shop ----------
    private void openShop() {
        if (shopOpen) return;
        shopOpen = true;
        shopVisits++;
        int interest = bonus("shopcoins");
        if (interest > 0) { coins += interest; totalCoinsEarned += interest; }
        freeRerollUsed = false;
        refreshDashboard();
        saveProgress();
        generateShopOffers();
        showShopDialog();
    }

    private void generateShopOffers() {
        shopOffers.clear();
        List<Upgrade> available = new ArrayList<Upgrade>();
        for (Upgrade u : upgradeCatalog) if (!has(u.id)) available.add(u);
        Collections.shuffle(available, random);
        for (int i = 0; i < Math.min(5, available.size()); i++) {
            Upgrade offer = available.get(i).copy();
            offer.cost = 10 + random.nextInt(19);
            shopOffers.add(offer);
        }
    }

