        dialog.add(scroll, BorderLayout.CENTER);

        JPanel footer = new JPanel(new FlowLayout(FlowLayout.CENTER, 10, 8)); footer.setBackground(BG);
        JButton reroll = makeButton(freeRerollUsed ? "REROLL — 5 COINS" : "FREE REROLL", new Color(89, 83, 134));
        reroll.setEnabled(!shopOffers.isEmpty() && (freeRerollUsed ? coins >= 5 : true));
        reroll.addActionListener(e -> {
            int cost = freeRerollUsed ? 5 : 0;
            if (coins < cost) return;
            coins -= cost; totalCoinsSpent += cost; freeRerollUsed = true;
            generateShopOffers(); dialog.dispose(); refreshDashboard(); showShopDialog();
        });
        JButton leave = makeButton("LEAVE SHOP", new Color(102, 77, 63));
        leave.addActionListener(e -> { dialog.dispose(); closeShop(); });
        footer.add(reroll); footer.add(leave); dialog.add(footer, BorderLayout.SOUTH);
        dialog.setVisible(true);
    }

    private JPanel shopOfferRow(Upgrade u, JDialog dialog) {
        JPanel row = new JPanel(new BorderLayout(12, 5));
        row.setBackground(PANEL);
        row.setBorder(new CompoundBorder(new LineBorder(GOLD, 1, true), new EmptyBorder(9, 12, 9, 12)));
        JPanel text = new JPanel(); text.setOpaque(false); text.setLayout(new BoxLayout(text, BoxLayout.Y_AXIS));
        JLabel name = new JLabel(u.name); name.setForeground(GOLD); name.setFont(new Font("Arial", Font.BOLD, 15));
        JLabel desc = new JLabel("<html><div style='width:410px;color:#f5f0df;'>" + u.description + "</div></html>");
        desc.setFont(SMALL);
        JLabel category = new JLabel(u.category.toUpperCase() + "  •  " + u.rarity);
        category.setForeground(MUTED); category.setFont(new Font("Arial", Font.BOLD, 9));
        text.add(name); text.add(Box.createVerticalStrut(3)); text.add(desc); text.add(Box.createVerticalStrut(3)); text.add(category);
        JButton buy = makeButton("BUY  " + u.cost, new Color(36, 125, 83));
        buy.setEnabled(coins >= u.cost);
        buy.addActionListener(e -> {
            if (coins < u.cost || has(u.id)) return;
            coins -= u.cost; totalCoinsSpent += u.cost;
            Upgrade original = findUpgrade(u.id);
            if (original != null) ownedUpgrades.add(original);
            upgradesBought++;
            seenUpgradeIds.add(u.id);
            shopOffers.remove(u);
            checkAchievements(); saveProgress();
            dialog.dispose();
            JOptionPane.showMessageDialog(this, u.name + " added to your permanent build!", "UPGRADE ACQUIRED", JOptionPane.INFORMATION_MESSAGE);
            refreshDashboard();
            showShopDialog();
        });
        row.add(text, BorderLayout.CENTER); row.add(buy, BorderLayout.EAST);
        return row;
    }

    private void closeShop() {
        shopOpen = false;
        lastResult = "Shop closed. Your upgrades are ready for the next round.";
        refreshReadyScreen();
